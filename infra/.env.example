# =============================================================================
# CATMS — Environment variables template
# Owner: Dev1  |  Issue: CATMS-011
#
# HOW TO USE:
#   cp infra/.env.example .env
#   # Edit .env and fill in values appropriate for your machine
#   # NEVER commit .env — it is excluded via .gitignore
#
# All variables listed here are required unless marked [optional].
# The API will refuse to start if any required variable is missing.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL — Development database
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catms_dev
POSTGRES_USER=catms_app
POSTGRES_PASSWORD=change_me_dev

# Superuser used only by Docker init and migration runner scripts.
# Never passed to the application.
POSTGRES_SUPERUSER=catms_super
POSTGRES_SUPERUSER_PASSWORD=change_me_super

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000

# JWT secret — minimum 64 characters, random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_plus_random_hex_characters

# HttpOnly cookie settings
COOKIE_SECURE=false          # Set to true in HTTPS environments
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_SECONDS=3600  # 1 hour

# CSRF — shared secret between API and browser (dev only; rotate for demo)
CSRF_SECRET=replace_with_random_csrf_secret

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Frontend origin(s) the API will accept — comma-separated, no trailing slash
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting (requests per window)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Prefix required by Vite for client-side exposure
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ---------------------------------------------------------------------------
# pgAdmin (optional profile — only when COMPOSE_PROFILES=pgadmin)
# ---------------------------------------------------------------------------
# [optional] PGADMIN_DEFAULT_EMAIL=admin@catms.local
# [optional] PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin
# [optional] PGADMIN_PORT=5050
