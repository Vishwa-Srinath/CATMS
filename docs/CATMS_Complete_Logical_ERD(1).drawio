at&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;TIMESTAMPTZ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#64748B;font-weight:700;&quot;&gt;NULL&lt;/span&gt;&lt;b&gt;resolved_at&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;TIMESTAMPTZ&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#1D4ED8;font-weight:700;&quot;&gt;FK NULL&lt;/span&gt;&lt;b&gt;processed_by_employee_id&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;BIGINT → EMPLOYEE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#7C3AED;font-weight:700;&quot;&gt;UQ&lt;/span&gt;&lt;b&gt;(invoice_id, policy_id)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;one claim per policy per invoice&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=7;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="insurance_claim"><mxGeometry x="0" y="36" width="455" height="374" as="geometry"/></mxCell><mxCell id="payment" value="PAYMENT" style="swimlane;html=1;startSize=36;horizontal=1;rounded=1;arcSize=8;collapsible=0;strokeColor=#BE123C;strokeWidth=1.7;fillColor=#BE123C;swimlaneFillColor=#FFFFFF;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="2480" y="1820" width="420" height="335" as="geometry"/></mxCell><mxCell id="payment_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:11.5px;line-height:1.43;color:#172033;&quot;&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#B42318;font-weight:700;&quot;&gt;PK&lt;/span&gt;&lt;b&gt;payment_id&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;BIGINT&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#1D4ED8;font-weight:700;&quot;&gt;FK&lt;/span&gt;&lt;b&gt;invoice_id&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;BIGINT → INVOICE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#1D4ED8;font-weight:700;&quot;&gt;FK&lt;/span&gt;&lt;b&gt;received_by_employee_id&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;BIGINT → EMPLOYEE&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#B45309;font-weight:700;&quot;&gt;CK&lt;/span&gt;&lt;b&gt;amount&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;DECIMAL(10,2) &gt; 0&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#B45309;font-weight:700;&quot;&gt;CK&lt;/span&gt;&lt;b&gt;payment_method&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;Cash | Card | Insurance | Online&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#64748B;font-weight:700;&quot;&gt;NULL&lt;/span&gt;&lt;b&gt;reference_no&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;VARCHAR(80)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;&quot;&gt;&lt;/span&gt;&lt;b&gt;paid_at&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;TIMESTAMPTZ DEFAULT now()&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:2px 3px;border-bottom:1px solid #EEF2F7;&quot;&gt;&lt;span style=&quot;display:inline-block;min-width:54px;color:#B45309;font-weight:700;&quot;&gt;RULE&lt;/span&gt;&lt;b&gt;payment cap&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;display:inline-block;margin-left:54px;color:#5B6474;&quot;&gt;sum ≤ patient_payable_amount&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=7;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="payment"><mxGeometry x="0" y="36" width="420" height="299" as="geometry"/></mxCell><mxCell id="design_panel" value="MODEL COMPLETENESS &amp; INTEGRITY NOTES" style="swimlane;html=1;startSize=38;horizontal=1;rounded=1;arcSize=8;collapsible=0;strokeColor=#334155;fillColor=#334155;swimlaneFillColor=#F8FAFC;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="900" height="560" as="geometry"/></mxCell><mxCell id="design_panel_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.46;color:#263244;&quot;&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Scope:&lt;/b&gt; 19 domain relations defined by the SRS plus &lt;b&gt;EMPLOYEE_CREDENTIAL&lt;/b&gt;, kept separate to satisfy NFR-9. The credential relation contains no patient or clinical data.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Subtype:&lt;/b&gt; DOCTOR uses EMPLOYEE.employee_id as its PK/FK. Only an active EMPLOYEE with role = Doctor may have this subtype.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Participation:&lt;/b&gt; every EMPLOYEE has one home BRANCH; every APPOINTMENT has one PATIENT, DOCTOR, BRANCH and creator. A PATIENT must have at least one EMERGENCY_CONTACT; a DOCTOR must have at least one SPECIALTY assignment.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Scheduling:&lt;/b&gt; scheduled_end &gt; scheduled_start; slots use 15-minute increments; a PostgreSQL exclusion rule prevents overlapping non-cancelled time ranges for the same doctor. Appointment branch must match the doctor’s home branch. Valid transitions are Scheduled → Completed/Cancelled; terminal states cannot be reversed in Phase 1.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Clinical gate:&lt;/b&gt; CONSULTATION_NOTE and APPOINTMENT_TREATMENT are allowed only after the APPOINTMENT becomes Completed. One note per appointment is enforced by UQ(appointment_id).&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Billing:&lt;/b&gt; APPOINTMENT_TREATMENT.unit_price_at_time is the documented historical price snapshot. INVOICE totals/status are database-maintained. Payments are atomic and cannot exceed patient_payable_amount.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Insurance:&lt;/b&gt; coverage is policy × treatment. Approved claim amount is the final covered amount; claim approval/rejection recalculates the patient balance in one transaction.&lt;/div&gt;&lt;div style=&quot;margin:0 0 7px 0;&quot;&gt;• &lt;b&gt;Lifecycle:&lt;/b&gt; historical master rows are retained. EMPLOYEE and TREATMENT_CATALOGUE use soft deactivation; appointments are cancelled by status, never deleted.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="design_panel"><mxGeometry x="0" y="38" width="900" height="522" as="geometry"/></mxCell><mxCell id="report_panel" value="DERIVED REPORTING OBJECTS · NOT BASE ENTITIES" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#F0FDFA;align=left;verticalAlign=top;spacingTop=13;spacingLeft=15;fontSize=13;fontStyle=1;fontColor=#0F766E;" vertex="1" parent="1"><mxGeometry x="970" y="1760" width="570" height="560" as="geometry"/></mxCell><mxCell id="report_panel_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:11.5px;line-height:1.45;color:#334155;&quot;&gt;&lt;b&gt;R1&lt;/b&gt; Branch daily appointment summary&lt;br/&gt;&lt;b&gt;R2&lt;/b&gt; Doctor gross vs collected revenue&lt;br/&gt;&lt;b&gt;R3&lt;/b&gt; Patient outstanding balances&lt;br/&gt;&lt;b&gt;R4&lt;/b&gt; Treatment count by category/date range&lt;br/&gt;&lt;b&gt;R5&lt;/b&gt; Monthly insurance-covered vs out-of-pocket totals&lt;br/&gt;&lt;span style=&quot;color:#64748B;&quot;&gt;Implemented as read-only views/parameterised functions over the relations above.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="985" y="1810" width="540" height="490" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="catms-reference" name="02 · Cardinality &amp; 3NF Reference"><mxGraphModel dx="2400" dy="1750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="CATMS · CARDINALITY, PARTICIPATION &amp; NORMALISATION REFERENCE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1900" height="45" as="geometry"/></mxCell><mxCell id="p2_subtitle" value="Companion sheet for defending the logical ERD during grading. Cardinalities are written from LEFT entity to RIGHT entity." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42" y="68" width="1900" height="30" as="geometry"/></mxCell><mxCell id="p2_legend" value="&lt;b&gt;Participation:&lt;/b&gt; 1 = exactly one · 0..1 = optional one · 0..* = optional many · 1..* = mandatory many &amp;nbsp;&amp;nbsp; &lt;b&gt;Line rule:&lt;/b&gt; endpoint symbols in Page 1 show the same minimum/maximum values." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fillColor=#F8FAFC;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="2320" height="54" as="geometry"/></mxCell><mxCell id="p2_h_0_0" value="&lt;b&gt;Parent / left&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="46" as="geometry"/></mxCell><mxCell id="p2_h_0_1" value="&lt;b&gt;Left&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="65" height="46" as="geometry"/></mxCell><mxCell id="p2_h_0_2" value="&lt;b&gt;Right&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="295" y="190" width="65" height="46" as="geometry"/></mxCell><mxCell id="p2_h_0_3" value="&lt;b&gt;Child / right&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="230" height="46" as="geometry"/></mxCell><mxCell id="p2_h_0_4" value="&lt;b&gt;FK / enforcing column&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="245" height="46" as="geometry"/></mxCell><mxCell id="p2_h_0_5" value="&lt;b&gt;Participation or semantic rule&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#1E293B;fontColor=#FFFFFF;strokeColor=#1E293B;align=center;spacingLeft=0;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="835" y="190" width="340" height="46" as="geometry"/></mxCell><mxCell id="p2_r_0_0_0" value="BRANCH" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="190" height="58" as="geometry"/></mxCell><mxCell id="p2_r_0_0_1" value="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="236" width="65" height=