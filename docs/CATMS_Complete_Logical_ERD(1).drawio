;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="2005" y="758" width="340" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_0" value="EMPLOYEE" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1210" y="816" width="190" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_1" value="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="816" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_2" value="0..*" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="816" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_3" value="PAYMENT" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1530" y="816" width="230" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_4" value="payment.received_by_employee_id" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1760" y="816" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_10_5" value="Required receiving staff member." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2005" y="816" width="340" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_0" value="INVOICE" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1210" y="874" width="190" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_1" value="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="874" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_2" value="0..*" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="874" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_3" value="INSURANCE_CLAIM" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1530" y="874" width="230" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_4" value="claim.invoice_id" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1760" y="874" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_11_5" value="A bill may split claims across policies." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="2005" y="874" width="340" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_0" value="INSURANCE_POLICY" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1210" y="932" width="190" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_1" value="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="932" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_2" value="0..*" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="932" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_3" value="INSURANCE_CLAIM" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1530" y="932" width="230" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_4" value="claim.policy_id" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1760" y="932" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_12_5" value="Policy must belong to invoice patient and be valid." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2005" y="932" width="340" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_0" value="EMPLOYEE" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1210" y="990" width="190" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_1" value="0..1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="990" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_2" value="0..*" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;align=center;spacingLeft=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1465" y="990" width="65" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_3" value="INSURANCE_CLAIM" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1530" y="990" width="230" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_4" value="claim.processed_by_employee_id" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1760" y="990" width="245" height="58" as="geometry"/></mxCell><mxCell id="p2_r_1_13_5" value="Null while Pending; finance actor on resolution." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10.5;fontColor=#273449;fillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="2005" y="990" width="340" height="58" as="geometry"/></mxCell><mxCell id="p2_norm" value="WHY THIS MODEL IS IN 3NF / BCNF" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;arcSize=8;collapsible=0;strokeColor=#2563EB;fillColor=#2563EB;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="720" height="440" as="geometry"/></mxCell><mxCell id="p2_norm_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:11.5px;line-height:1.48;color:#263244;&quot;&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Every non-key fact is stored once under the key that determines it: branch facts in BRANCH, employee facts in EMPLOYEE, treatment facts in TREATMENT_CATALOGUE, and policy terms in POLICY_COVERAGE.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• All M:N relationships are resolved through junction/associative relations: DOCTOR_SPECIALTY, POLICY_COVERAGE and APPOINTMENT_TREATMENT.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Repeating emergency contacts, payments, claims, treatments and specialties are separate rows—not arrays, numbered columns or comma-separated values.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• The intentional historical snapshot unit_price_at_time depends on the administered line item; it prevents catalogue-price updates from changing past invoices.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Invoice totals are controlled aggregate facts maintained only by database procedures/triggers; application users cannot edit them.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p2_norm"><mxGeometry x="0" y="40" width="720" height="400" as="geometry"/></mxCell><mxCell id="p2_keys" value="CRITICAL KEYS &amp; CONSTRAINTS" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;arcSize=8;collapsible=0;strokeColor=#6D28D9;fillColor=#6D28D9;swimlaneFillColor=#F5F3FF;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="800" y="1150" width="760" height="440" as="geometry"/></mxCell><mxCell id="p2_keys_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:11.5px;line-height:1.48;color:#263244;&quot;&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Unique: employee.nic; doctor.medical_license_no; patient.nic_or_passport; treatment.service_code; branch.name; credential.username and credential.employee_id.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Composite unique: doctor + specialty; provider + policy number; policy + treatment; appointment + treatment; invoice + policy claim.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• One-to-one unique FKs: branch.manager_employee_id, credential.employee_id, consultation_note.appointment_id, invoice.appointment_id.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Checks: dates ordered; appointment end after start; 15-minute increments; positive quantities/payments/durations; percentages 0–100; non-negative money; enumerated states.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• PostgreSQL EXCLUDE: doctor_id WITH = and tstzrange(start,end,'[)') WITH &amp;&amp;, WHERE status &lt;&gt; Cancelled.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p2_keys"><mxGeometry x="0" y="40" width="760" height="400" as="geometry"/></mxCell><mxCell id="p2_scope" value="SCOPE, REPORTS &amp; DELETE POLICY" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;arcSize=8;collapsible=0;strokeColor=#0F766E;fillColor=#0F766E;swimlaneFillColor=#F0FDFA;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1600" y="1150" width="760" height="440" as="geometry"/></mxCell><mxCell id="p2_scope_body" value="&lt;div style=&quot;font-family:Inter,Arial,sans-serif;font-size:11.5px;line-height:1.48;color:#263244;&quot;&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Physical scope: 19 domain relations from the SRS + 1 isolated authentication relation required by NFR-9. Reporting objects are derived and therefore are not entities.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Reports: daily branch status counts; doctor gross/collected revenue; outstanding patient balances; treatment category counts; monthly insurance vs out-of-pocket totals.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• RESTRICT deletes for referenced master/transaction rows. EMPLOYEE, TREATMENT_CATALOGUE, BRANCH and PATIENT are retired through is_active rather than physical deletion.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• CASCADE is suitable only for ownership rows that cannot exist independently (e.g. credentials, emergency contacts, pure junction assignments), subject to final migration review.&lt;/div&gt;&lt;div style=&quot;margin:0 0 11px 0;&quot;&gt;• Audit/history and cancelled appointments are immutable/retained. Nullable processed_by uses SET NULL only if personnel deletion is ever allowed; Phase 1 uses soft deletion.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p2_scope"><mxGeometry x="0" y="40" width="760" height="400" as="geometry"/></mxCell><mxCell id="p2_footer" value="&lt;b&gt;Implementation consistency rule:&lt;/b&gt; the final SQL DDL, migration names, data dictionary and this ERD must use these same table/column names and cardinalities. If the schema changes, update all four artifacts in the same pull request." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F59E0B;fillColor=#FFFBEB;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="2320" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
