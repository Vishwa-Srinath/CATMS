<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="Codex" version="24.7.17" type="device" pages="7"><diagram id="master-physical-erd" name="01 · Complete Physical ERD"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="7100" pageHeight="4250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m_title" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;font-size:30px;font-weight:700;color:#102A43&quot;&gt;CATMS · COMPLETE PRODUCTION PHYSICAL ERD&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:13px;color:#52667A&quot;&gt;PostgreSQL 16 implementation baseline · 34 base relations · full attributes, keys, data types, cardinalities, audit and financial allocation model&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="6960" height="80" as="geometry"/></mxCell><mxCell id="m_legend" value="&lt;b&gt;KEY&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; primary &amp;nbsp; &lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; foreign &amp;nbsp; &lt;font color=&quot;#7C3AED&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; unique &amp;nbsp; &lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; check &amp;nbsp; &lt;font color=&quot;#0F766E&quot;&gt;&lt;b&gt;DB&lt;/b&gt;&lt;/font&gt; trigger/procedure-maintained &amp;nbsp; Dashed reference lines cross module ownership boundaries. Zoom into any table for implementation attributes." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;align=left;verticalAlign=middle;spacingLeft=14;fontSize=11;fontColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="6960" height="55" as="geometry"/></mxCell><mxCell id="lane_a" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;b&gt;A · BRANCH, STAFF &amp; ACCESS&lt;/b&gt;&lt;span style=&quot;margin-left:12px;font-size:10px;font-weight:400&quot;&gt;employment history, doctor specialization, authentication and scoped RBAC&lt;/span&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;rounded=1;arcSize=5;collapsible=0;strokeColor=#2563EB;fillColor=#2563EB;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;opacity=30;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="2840" height="1780" as="geometry"/></mxCell><mxCell id="lane_b" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;b&gt;B · PATIENT &amp; INSURANCE TERMS&lt;/b&gt;&lt;span style=&quot;margin-left:12px;font-size:10px;font-weight:400&quot;&gt;clinic-wide identity, contacts, providers, policies and effective coverage&lt;/span&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;rounded=1;arcSize=5;collapsible=0;strokeColor=#7C3AED;fillColor=#7C3AED;swimlaneFillColor=#FAF5FF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;opacity=30;" vertex="1" parent="1"><mxGeometry x="2960" y="200" width="4040" height="1160" as="geometry"/></mxCell><mxCell id="lane_c" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;b&gt;C · SCHEDULING &amp; DOMAIN AUDIT&lt;/b&gt;&lt;span style=&quot;margin-left:12px;font-size:10px;font-weight:400&quot;&gt;availability, conflict-safe appointments, schedule and status history&lt;/span&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;rounded=1;arcSize=5;collapsible=0;strokeColor=#0F766E;fillColor=#0F766E;swimlaneFillColor=#ECFDF5;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;opacity=30;" vertex="1" parent="1"><mxGeometry x="2960" y="1420" width="4040" height="1040" as="geometry"/></mxCell><mxCell id="lane_d" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;b&gt;D · CLINICAL &amp; TREATMENT&lt;/b&gt;&lt;span style=&quot;margin-left:12px;font-size:10px;font-weight:400&quot;&gt;note revisions, catalogue taxonomy and price-at-service snapshots&lt;/span&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;rounded=1;arcSize=5;collapsible=0;strokeColor=#6D28D9;fillColor=#6D28D9;swimlaneFillColor=#F5F3FF;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;opacity=30;" vertex="1" parent="1"><mxGeometry x="40" y="2040" width="2840" height="1980" as="geometry"/></mxCell><mxCell id="lane_e" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;b&gt;E · BILLING, CLAIMS &amp; PAYMENTS&lt;/b&gt;&lt;span style=&quot;margin-left:12px;font-size:10px;font-weight:400&quot;&gt;invoice snapshots, treatment-level insurance allocation, receipts and reversals&lt;/span&gt;&lt;/div&gt;" style="swimlane;html=1;startSize=48;horizontal=1;rounded=1;arcSize=5;collapsible=0;strokeColor=#B45309;fillColor=#B45309;swimlaneFillColor=#FFFBEB;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;opacity=30;" vertex="1" parent="1"><mxGeometry x="2960" y="2520" width="4040" height="1500" as="geometry"/></mxCell><mxCell id="m_branch" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; branch_code : CITEXT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; name : VARCHAR(120)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;address_line_1 : VARCHAR(180)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;address_line_2 : VARCHAR(180) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;city : VARCHAR(80)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;district : VARCHAR(80) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;postal_code : VARCHAR(20) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;contact_phone : VARCHAR(25)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;time_zone : VARCHAR(40) DEFAULT Asia/Colombo&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;is_active : BOOLEAN DEFAULT TRUE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at / updated_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Referenced branches are deactivated, never physically deleted.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="620" height="386" as="geometry"/></mxCell><mxCell id="m_employee" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; employee_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; employee_no : VARCHAR(24)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; nic_normalized : VARCHAR(24)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;full_name : VARCHAR(150)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; gender_code : configured value set&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;date_of_birth : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; position_code : Manager|Doctor|Nurse|Receptionist|Admin|Other&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;phone : VARCHAR(25)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;email : CITEXT NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;hire_date : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; employment_status : Active|Inactive|Terminated&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;terminated_at : DATE NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at / updated_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Position describes employment; USER_ACCOUNT_ROLE controls authorization.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="790" y="280" width="620" height="411" as="geometry"/></mxCell><mxCell id="m_assignment" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;EMPLOYEE_BRANCH_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; employee_branch_assignment_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; employee_id : BIGINT → EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT → BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; assignment_type : Primary|Temporary&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_from : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_to : DATE NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; assigned_by_user_id : BIGINT → USER_ACCOUNT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; valid_to IS NULL OR valid_to &amp;gt;= valid_from&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#0F766E&quot;&gt;DB&lt;/span&gt;&amp;nbsp; one active Primary assignment per employee&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Validity ranges must not overlap for Primary assignments.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1480" y="280" width="620" height="336" as="geometry"/></mxCell><mxCell id="m_manager" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;BRANCH_MANAGER_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; branch_manager_assignment_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;fon