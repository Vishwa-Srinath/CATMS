ange settled historical bills.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#6D28D9;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1210" y="1010" width="530" height="336" as="geometry"/></mxCell><mxCell id="p3_e1" value="registered at" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p3_branch_ref" target="p3_patient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e2" value="created by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p3_user_ref" target="p3_patient"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e3" value="identities" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_patient" target="p3_identity"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e4" value="emergency contacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_patient" target="p3_contact"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e5" value="policies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_patient" target="p3_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e6" value="issues" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_provider" target="p3_policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e7" value="effective terms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3_policy" target="p3_coverage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e8" value="covered treatment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p3_treatment_ref" target="p3_coverage"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="05 · Scheduling &amp; Clinical Care"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_title" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:700;color:#102A43&quot;&gt;MODULES C–D · AVAILABILITY, APPOINTMENTS, CLINICAL NOTES &amp;amp; DELIVERED TREATMENTS&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:12px;color:#52667A&quot;&gt;The calendar is advisory; the database exclusion rule is authoritative. Clinical text is revisioned and treatment prices are snapshotted.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2780" height="70" as="geometry"/></mxCell><mxCell id="p4_rule" value="&lt;b&gt;Scheduling invariant:&lt;/b&gt; &lt;font face=&quot;monospace&quot;&gt;EXCLUDE USING gist (doctor_id WITH =, tstzrange(scheduled_start, scheduled_end,'[)') WITH &amp;amp;&amp;amp;) WHERE (status &amp;lt;&amp;gt; 'Cancelled')&lt;/font&gt;. Install &lt;font face=&quot;monospace&quot;&gt;btree_gist&lt;/font&gt;. This constraint handles concurrent inserts; row-locking existing appointments alone does not lock an empty time gap." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#6EE7B7;fillColor=#ECFDF5;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2780" height="70" as="geometry"/></mxCell><mxCell id="p4_patient_ref" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#64748B;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;PATIENT&lt;span style=&quot;font-size:9px;font-weight:400;opacity:.85&quot;&gt; · reference&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; patient_id : BIGINT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; patient_number : VARCHAR(24)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#64748B;strokeWidth=1;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="330" height="88" as="geometry"/></mxCell><mxCell id="p4_doctor_ref" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#64748B;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;DOCTOR_PROFILE&lt;span style=&quot;font-size:9px;font-weight:400;opacity:.85&quot;&gt; · reference&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; doctor_id : BIGINT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; medical_license_no : CITEXT&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#64748B;strokeWidth=1;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="420" y="220" width="370" height="88" as="geometry"/></mxCell><mxCell id="p4_branch_ref" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#64748B;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;BRANCH&lt;span style=&quot;font-size:9px;font-weight:400;opa