px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; A partial unique index enforces one current manager without a Branch↔Employee circular FK.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="2170" y="280" width="620" height="336" as="geometry"/></mxCell><mxCell id="m_doctor" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#1D4ED8;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;DOCTOR_PROFILE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&lt;span style=&quot;color:#94A3B8&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; doctor_id : BIGINT → EMPLOYEE.employee_id&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; medical_license_no : CITEXT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;practice_start_date : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;default_consultation_fee : NUMERIC(12,2) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;is_accepting_appointments : BOOLEAN DEFAULT TRUE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-t