;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT → BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; weekday_iso : SMALLINT BETWEEN 1 AND 7&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;local_start_time : TIME&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;local_end_time : TIME&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;slot_minutes : SMALLINT DEFAULT 15&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_from : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_to : DATE NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;is_active : BOOLEAN DEFAULT TRUE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; local_end_time &amp;gt; local_start_time&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b