y"/></mxCell><mxCell id="m_edge_59" value="payment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#52667A;strokeWidth=1.15;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m_payment" target="m_reversal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m_edge_60" value="reversed_by_user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94A3B8;strokeWidth=1.15;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="m_user" target="m_reversal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m_footer" value="&lt;b&gt;Database authority:&lt;/b&gt; overlap exclusion, effective-date validation, state transitions, completed-only care entry, invoice/claim/payment totals, payer-specific caps, immutability and actor authorization are enforced through PostgreSQL constraints and controlled transactional procedures. See the module pages for uncluttered inspection and the final reference page for build order." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#F0FDFA;align=left;verticalAlign=middle;spacingLeft=14;fontSize=11;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="40" y="4080" width="6960" height="75" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="02 · Model Overview"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:700;color:#102A43&quot;&gt;CATMS · PRODUCTION IMPLEMENTATION ERD&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:12px;color:#52667A&quot;&gt;PostgreSQL 16 · editable Draw.io source · 34 base relations + 5 derived reporting objects · UTC storage / Asia/Colombo presentation&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2380" height="70" as="geometry"/></mxCell><mxCell id="p1_legend" value="&lt;b&gt;Notation&lt;/b&gt;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#B42318&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; primary &amp;nbsp; &lt;font color=&quot;#1D4ED8&quot;&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; foreign &amp;nbsp; &lt;font color=&quot;#7C3AED&quot;&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/font&gt; unique &amp;nbsp; &lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;CK&lt;/b&gt;&lt;/font&gt; check &amp;nbsp; &lt;font color=&quot;#0F766E&quot;&gt;&lt;b&gt;DB&lt;/b&gt;&lt;/font&gt; trigger/procedure maintained &amp;nbsp; Crow’s-foot endpoints show minimum/maximum participation." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2380" height="52" as="geometry"/></mxCell><mxCell id="p1_a" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;A · BRANCH, STAFF &amp;amp; ACCESS&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Current assignments and historical validity are separated. Employment position is not used as an authorization role.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;BRANCH&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;EMPLOYEE_BRANCH_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;BRANCH_MANAGER_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;DOCTOR_PROFILE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;SPECIALTY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;DOCTOR_SPECIALTY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;USER_ACCOUNT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;APP_ROLE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;USER_ACCOUNT_ROLE&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="710" height="590" as="geometry"/></mxCell><mxCell id="p1_b" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#7C3AED;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;B · PATIENT &amp;amp; INSURANCE TERMS&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Clinic-wide patient identity with versioned, treatment-specific policy terms.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;PATIENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;PATIENT_IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;EMERGENCY_CONTACT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INSURANCE_PROVIDER&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INSURANCE_POLICY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;POLICY_COVERAGE&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="890" y="210" width="710" height="430" as="geometry"/></mxCell><mxCell id="p1_c" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#0F766E;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;C · SCHEDULING &amp;amp; DOMAIN AUDIT&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Availability assists booking; the PostgreSQL exclusion constraint is the concurrency authority.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;DOCTOR_AVAILABILITY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;DOCTOR_AVAILABILITY_EXCEPTION&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;APPOINTMENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;APPOINTMENT_SCHEDULE_HISTORY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;APPOINTMENT_STATUS_LOG&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1740" y="210" width="680" height="400" as="geometry"/></mxCell><mxCell id="p1_d" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#6D28D9;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;D · CLINICAL &amp;amp; TREATMENT&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Completed-only care entry, append-only note revisions, and price-at-service snapshots.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;CONSULTATION_NOTE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;CONSULTATION_NOTE_REVISION&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;TREATMENT_CATEGORY&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;TREATMENT_CATALOGUE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;APPOINTMENT_TREATMENT&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#6D28D9;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="710" height="400" as="geometry"/></mxCell><mxCell id="p1_e" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#B45309;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;E · BILLING, CLAIMS &amp;amp; RECEIPTS&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Approved coverage, patient liability, patient receipts and insurer receipts are distinct facts.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INVOICE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INVOICE_LINE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INSURANCE_CLAIM&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INSURANCE_CLAIM_LINE&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;INSURANCE_CLAIM_STATUS_LOG&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;PAYMENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;PAYMENT_REVERSAL&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#B45309;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="890" y="820" width="710" height="500" as="geometry"/></mxCell><mxCell id="p1_f" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#475569;color:#FFFFFF;padding:11px 13px;font-size:14px;font-weight:700&quot;&gt;F · AUDIT &amp;amp; REPORTING LAYER&lt;/div&gt;&lt;div style=&quot;padding:10px 13px;color:#52667A;font-size:10.5px;line-height:1.35&quot;&gt;Generic security/administration audit complements the immutable domain histories. Reports are read-only, not base entities.&lt;/div&gt;&lt;div style=&quot;padding:0 13px 12px&quot;&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;AUDIT_EVENT&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;R1_BRANCH_DAILY_APPOINTMENTS · view/function&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;R2_DOCTOR_REVENUE · view/function&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;R3_PATIENT_OUTSTANDING · view&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;R4_TREATMENTS_BY_CATEGORY · function&lt;/div&gt;&lt;div style=&quot;padding:4px 0;border-bottom:1px solid #E5E7EB;font-family:monospace;font-size:11px;color:#263B50&quot;&gt;R5_MONTHLY_FUNDING_MIX · view/function&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;strokeColor=#475569;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1740" y="760" width="680" height="455" as="geometry"/></mxCell><mxCell id="p1_f1" value="staff and doctor eligibility" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_a" target="p1_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_f2" value="clinic-wide patient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_b" target="p1_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_f3" value="completed appointment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_c" target="p1_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_f4" value="billable service lines" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_d" target="p1_e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_f5" value="financial facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1_e" target="p1_f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_decisions" value="&lt;div style=&quot;font-size:13px;font-weight:700;color:#102A43;margin-bottom:8px&quot;&gt;Frozen production decisions&lt;/div&gt;&lt;div style=&quot;line-height:1.55&quot;&gt;1. PostgreSQL is the integrity authority; APIs call controlled procedures.&lt;br&gt;2. Appointment overlap uses a GiST exclusion constraint over &lt;font face=&quot;monospace&quot;&gt;[start,end)&lt;/font&gt; for every non-cancelled appointment.&lt;br&gt;3. Insurance eligibility is calculated per invoice line; only approved claim amounts reduce patient liability.&lt;br&gt;4. Payment payer (Patient/Insurer) is separate from tender method (Cash/Card/BankTransfer/Online).&lt;br&gt;5. Clinical, appointment, claim, payment and security history is append-only.&lt;br&gt;6. Historical documents retain service/description/price/coverage snapshots.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5EEAD4;fillColor=#F0FDFA;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="2380" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="03 · Branch, Staff &amp; Access"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:700;color:#102A43&quot;&gt;MODULE A · BRANCH, STAFF, AUTHENTICATION &amp;amp; AUTHORIZATION&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:12px;color:#52667A&quot;&gt;Historical branch/manager assignments remove circular foreign keys and preserve transfers. Application authorization is separate from employment position.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2450" height="70" as="geometry"/></mxCell><mxCell id="p2_key" value="&lt;b&gt;Participation:&lt;/b&gt; every active employee has exactly one active Primary branch assignment; a branch may have many staff assignments; every active branch has one current manager after setup; a user may hold multiple scoped application roles." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="2450" height="55" as="geometry"/></mxCell><mxCell id="p2_branch" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; branch_code : CITEXT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; name : VARCHAR(120)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;address_line_1 : VARCHAR(180)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;address_line_2 : VARCHAR(180) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;city : VARCHAR(80)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;district : VARCHAR(80) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;postal_code : VARCHAR(20) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;contact_phone : VARCHAR(25)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;time_zone : VARCHAR(40) DEFAULT Asia/Colombo&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;is_active : BOOLEAN DEFAULT TRUE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at / updated_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Referenced branches are deactivated, never physically deleted.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="430" height="386" as="geometry"/></mxCell><mxCell id="p2_employee" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; employee_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; employee_no : VARCHAR(24)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; nic_normalized : VARCHAR(24)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;full_name : VARCHAR(150)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; gender_code : configured value set&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;date_of_birth : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; position_code : Manager|Doctor|Nurse|Receptionist|Admin|Other&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;phone : VARCHAR(25)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;email : CITEXT NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;hire_date : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; employment_status : Active|Inactive|Terminated&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;terminated_at : DATE NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at / updated_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Position describes employment; USER_ACCOUNT_ROLE controls authorization.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="540" y="230" width="470" height="411" as="geometry"/></mxCell><mxCell id="p2_assignment" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;EMPLOYEE_BRANCH_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; employee_branch_assignment_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; employee_id : BIGINT → EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT → BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; assignment_type : Primary|Temporary&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_from : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_to : DATE NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; assigned_by_user_id : BIGINT → USER_ACCOUNT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; valid_to IS NULL OR valid_to &amp;gt;= valid_from&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#0F766E&quot;&gt;DB&lt;/span&gt;&amp;nbsp; one active Primary assignment per employee&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Validity ranges must not overlap for Primary assignments.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#2563EB;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1090" y="230" width="500" height="336" as="geometry"/></mxCell><mxCell id="p2_manager" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#2563EB;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;BRANCH_MANAGER_ASSIGNMENT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; branch_manager_assignment_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; branch_id : BIGINT → BRANCH&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; employee_id : BIGINT → EMPLOYEE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;valid_from : DATE&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;