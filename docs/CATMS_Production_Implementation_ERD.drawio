ght="311" as="geometry"/></mxCell><mxCell id="p5_reports" value="&lt;div style=&quot;font-size:13px;font-weight:700;color:#102A43;margin-bottom:8px&quot;&gt;DERIVED REPORTING OBJECTS · READ ONLY&lt;/div&gt;&lt;b&gt;R1&lt;/b&gt; Branch daily status counts using Asia/Colombo scheduled date.&lt;br&gt;&lt;b&gt;R2&lt;/b&gt; Doctor gross by service date and actual receipts by payment date; filters expose both bases clearly.&lt;br&gt;&lt;b&gt;R3&lt;/b&gt; Patient outstanding = patient liability − net settled patient receipts.&lt;br&gt;&lt;b&gt;R4&lt;/b&gt; Delivered quantity by treatment category and service date.&lt;br&gt;&lt;b&gt;R5&lt;/b&gt; Monthly funding mix: approved insurance, insurer receipts, and patient receipts shown separately." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fillColor=#F8FAFC;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1900" y="1330" width="750" height="300" as="geometry"/></mxCell><mxCell id="p5_e1" value="generates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p5_appt_ref" target="p5_invoice"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e2" value="invoice lines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_invoice" target="p5_invline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e3" value="billed snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p5_treat_ref" target="p5_invline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e4" value="claims" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_invoice" target="p5_claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e5" value="claimed policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p5_policy_ref" target="p5_claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e6" value="line allocations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_claim" target="p5_claimline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e7" value="covered line" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_invline" target="p5_claimline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e8" value="status audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_claim" target="p5_claimlog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e9" value="receipts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_invoice" target="p5_payment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e10" value="insurer receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p5_claim" target="p5_payment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5_e11" value="reversals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.3;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5_payment" target="p5_reversal"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-6" name="07 · Constraints &amp; Build Reference"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_title" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:700;color:#102A43&quot;&gt;CATMS · DATABASE CONSTRAINT, TRANSACTION &amp;amp; DELIVERY REFERENCE&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:12px;color:#52667A&quot;&gt;Companion sheet for turning the ERD into PostgreSQL migrations without losing cross-table invariants.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2580" height="70" as="geometry"/></mxCell><mxCell id="p6_proc" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Required controlled procedures / transaction boundaries&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10.5px&quot;&gt;&lt;tr&gt;&lt;th align=&quot;left&quot;&gt;Procedure&lt;/th&gt;&lt;th align=&quot;left&quot;&gt;Atomic responsibility&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;register_patient&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Patient + primary identity + at least one emergency contact.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;assign_employee_branch / assign_branch_manager&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Close prior validity range, validate position/current branch, insert immutable assignment.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;book_appointment / reschedule_appointment&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Validate active references, specialty, assignment, availability and 15-minute slot; rely on exclusion constraint; write history.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;change_appointment_status&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Validate transition and actor; update current state and append status event.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;record_care_and_issue_invoice&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Completed-only note revision + treatment price snapshots + invoice/line creation and total calculation.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;submit_claim / resolve_claim&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Policy/patient/date validation, line eligibility/allocation, status history, approval and invoice liability recalculation.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;font face=&quot;monospace&quot;&gt;post_payment / reverse_payment&lt;/font&gt;&lt;/td&gt;&lt;td&gt;Lock invoice, enforce payer-specific cap/idempotency, insert append-only receipt/reversal and recalculate totals.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fillColor=#F8FAFC;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1260" height="550" as="geometry"/></mxCell><mxCell id="p6_checks" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Direct checks and conditional constraints&lt;/div&gt;• Every end/date range is ordered; quantities and actual payments are positive.&lt;br&gt;• Money is &lt;font face=&quot;monospace&quot;&gt;NUMERIC(12,2)&lt;/font&gt;; currency is LKR in Phase 1.&lt;br&gt;• Claim: Pending has no resolver; Rejected has approved=0; PartiallyApproved has 0&amp;lt;approved&amp;lt;claimed; Approved has approved&amp;gt;0.&lt;br&gt;• Invoice: approved insurance ≤ subtotal; patient liability = subtotal − approved insurance; patient paid ≤ liability unless an explicit credit/refund workflow exists.&lt;br&gt;• Appointment: terminal states cannot be reopened in Phase 1; cancelled rows remain retained.&lt;br&gt;• Policy: service date must fall in validity window and status must permit claims.&lt;br&gt;• All actor IDs reference enabled accounts with the necessary role at operation time." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#FCD34D;fillColor=#FFFBEB;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="1260" height="550" as="geometry"/></mxCell><mxCell id="p6_indexes" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Indexes and exclusion rules&lt;/div&gt;1. Enable &lt;font face=&quot;monospace&quot;&gt;btree_gist&lt;/font&gt;; appointment doctor/range exclusion is the concurrency guarantee.&lt;br&gt;2. Partial unique: one active Primary employee branch; one active branch manager; one primary patient identity/contact; one primary doctor specialty.&lt;br&gt;3. B-tree: appointment(branch_id, scheduled_start), appointment(patient_id, scheduled_start DESC), appointment_treatment(treatment_id, administered_at).&lt;br&gt;4. B-tree: invoice(patient_payment_status, issued_at), claim(status, submitted_at), payment(invoice_id, payment_status, paid_at).&lt;br&gt;5. Search indexes only after measured need: normalized patient identity, patient name/phone trigram if enabled.&lt;br&gt;6. Verify report and overlap plans with &lt;font face=&quot;monospace&quot;&gt;EXPLAIN (ANALYZE, BUFFERS)&lt;/font&gt;." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1260" height="470" as="geometry"/></mxCell><mxCell id="p6_delete" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Lifecycle and delete policy&lt;/div&gt;• RESTRICT deletion of referenced master, clinical and financial records.&lt;br&gt;• Deactivate Branch, Employee, Doctor, Specialty, Patient, Provider and Treatment records.&lt;br&gt;• CASCADE only true ownership rows before business history exists, such as an unused account role assignment or an unissued draft line.&lt;br&gt;• Appointment histories, note revisions, claim histories, payments, reversals and audit events are append-only.&lt;br&gt;• Issued invoice/claim/payment corrections use reversal or compensating rows—not UPDATE/DELETE.&lt;br&gt;• Define retention, archival, backup encryption and restore testing before real patient data." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#FCA5A5;fillColor=#FEF2F2;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="1380" y="760" width="1260" height="470" as="geometry"/></mxCell><mxCell id="p6_security" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Security boundary&lt;/div&gt;• Browser never connects to PostgreSQL.&lt;br&gt;• API validates input, verifies role and calls allow-listed functions/procedures.&lt;br&gt;• Database roles receive EXECUTE on procedures and SELECT on approved views—not broad table writes.&lt;br&gt;• Use &lt;font face=&quot;monospace&quot;&gt;SET LOCAL ROLE&lt;/font&gt; inside a transaction; reset is automatic at commit/rollback.&lt;br&gt;• Domain errors return stable codes and sanitized messages; raw SQL errors never reach users.&lt;br&gt;• Password hashes, secrets and patient data never enter application logs.&lt;br&gt;• Production requires HTTPS, secure HttpOnly cookies, rate limits, secrets management and monitored encrypted backups." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#5EEAD4;fillColor=#F0FDFA;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#134E4A;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1260" height="430" as="geometry"/></mxCell><mxCell id="p6_gates" value="&lt;div style=&quot;font-size:14px;font-weight:700;color:#102A43;margin-bottom:10px&quot;&gt;Build order and acceptance gates&lt;/div&gt;&lt;b&gt;G0&lt;/b&gt; Approve this ERD, financial worked example, role matrix, state transitions and report date semantics.&lt;br&gt;&lt;b&gt;G1&lt;/b&gt; Migrate A/B → C/D → E from an empty PostgreSQL 16 database; compare catalogue to ERD.&lt;br&gt;&lt;b&gt;G2&lt;/b&gt; Direct-SQL positive, negative, boundary, concurrent and rollback tests pass before API implementation.&lt;br&gt;&lt;b&gt;G3&lt;/b&gt; API contract/RBAC tests pass, including direct database denial.&lt;br&gt;&lt;b&gt;G4&lt;/b&gt; Connect the existing React prototype; remove in-browser “DB” simulations.&lt;br&gt;&lt;b&gt;G5&lt;/b&gt; Reconcile every report and the golden financial example; capture EXPLAIN evidence.&lt;br&gt;&lt;b&gt;G6&lt;/b&gt; Clean install/reset/backup/restore/offline demo and full REQ/NFR traceability pass." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#C4B5FD;fillColor=#F5F3FF;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1"><mxGeometry x="1380" y="1300" width="1260" height="430" as="geometry"/></mxCell><mxCell id="p6_footer" value="&lt;b&gt;Consistency rule:&lt;/b&gt; migration names, table/column names, API contracts, seed fixtures, data dictionary and this ERD change together. Any intentional Phase 1 simplification must be recorded as an architecture decision with its production migration path." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="2600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
