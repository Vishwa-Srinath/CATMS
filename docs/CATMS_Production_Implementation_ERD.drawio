)&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; payment_method : Cash|Card|BankTransfer|Online&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; payment_status : Pending|Settled|Voided|PartiallyReversed|Reversed&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;reference_number : VARCHAR(100) NULL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#7C3AED&quot;&gt;UQ&lt;/span&gt;&amp;nbsp; idempotency_key : UUID&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; received_by_user_id : BIGINT → USER_ACCOUNT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;paid_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;created_at : TIMESTAMPTZ&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B45309&quot;&gt;CK&lt;/span&gt;&amp;nbsp; amount &amp;gt; 0&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#0F766E&quot;&gt;DB&lt;/span&gt;&amp;nbsp; insurer payer requires an approved claim&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#0F766E&quot;&gt;DB&lt;/span&gt;&amp;nbsp; payer-specific overpayment cap under invoice lock&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #D8E2EA;background:#F8FAFC;padding:7px 9px;font-size:9.5px;line-height:1.28;color:#52667A&quot;&gt;&lt;b&gt;RULE&lt;/b&gt; Insurance is a payer, not a tender method. Posting locks the invoice and recalculates totals atomically.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;strokeColor=#B45309;strokeWidth=1.5;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="550" height="486" as="geometry"/></mxCell><mxCell id="p5_reversal" value="&lt;div style=&quot;font-family:Arial,sans-serif&quot;&gt;&lt;div style=&quot;background:#B45309;color:#FFFFFF;padding:9px 10px;font-size:12px;font-weight:700;letter-spacing:.2px&quot;&gt;PAYMENT_REVERSAL&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:0;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#B42318&quot;&gt;PK&lt;/span&gt;&amp;nbsp; payment_reversal_id : BIGINT IDENTITY&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;&gt;&lt;span style=&quot;font-weight:700;color:#1D4ED8&quot;&gt;FK&lt;/span&gt;&amp;nbsp; payment_id : BIGINT → PAYMENT&lt;/div&gt;&lt;div style=&quot;padding:5px 9px;border-top:1px solid #E9EEF3;font-family:monospace;font-size:9.8px;line-height:1.23;color:#263B50&quot;